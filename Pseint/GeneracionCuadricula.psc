Algoritmo GeneracionCuadricula
	
    Definir filas, columnas, fila, columna Como Entero
	
    filas <- 15
    columnas <- 10
	
    Para fila <- 1 Hasta filas Hacer
		
        Para columna <- 1 Hasta columnas Hacer
			
            Escribir "Crear celda en fila ", fila, " columna ", columna
			
        FinPara
		
    FinPara
	
FinAlgoritmo